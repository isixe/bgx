{
  "name": "bgx",
  "type": "module",
  "version": "0.2.1",
  "description": "Client-side AI background removal tool",
  "author": {
    "name": "isixe",
    "email": "isixe@outlook.com"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "dev:electron": "concurrently -k -s first \"astro dev\" \"wait-on -t 60000 tcp:127.0.0.1:4321 && cross-env ELECTRON_DEV=1 electron .\"",
    "start": "electron .",
    "build": "astro build",
    "build:win": "astro build && electron-builder --win",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "postinstall": "node -e \"const fs=require('fs'),s='node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.wasm',d='public/ort-wasm-simd-threaded.wasm';if(fs.existsSync(s)){fs.copyFileSync(s,d);console.log('WASM copied to public/')}else{console.log('WASM not found, skipping')}\""
  },
  "build": {
    "appId": "dev.itea.bgx",
    "productName": "BGX",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!**/node_modules/**",
      "package.json"
    ],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "icon": "public/favicon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "public/favicon.png",
      "category": "Graphics",
      "synopsis": "AI background removal",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "mac": {
      "icon": "public/favicon.png",
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "BGX"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "@astrojs/react": "^4.0.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "astro": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.8.0",
    "modern-rembg": "latest",
    "onnxruntime-web": "^1.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@astrojs/tailwind": "^5.1.3",
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^3.4.16",
    "typescript-eslint": "^8.67.0",
    "wait-on": "^9.5.1"
  }
}
