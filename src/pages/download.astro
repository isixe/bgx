---
import Layout from '../layouts/Layout.astro';
import { DownloadPage } from '../components/features/DownloadPage';
import { fetchLatestRelease, type ReleaseInfo } from '../lib/release';

const metadata = {
  title: 'BGX - Download Desktop App',
  description:
    'Download the BGX desktop app for Windows, macOS and Linux. Free, offline AI background removal with batch processing.',
  keywords: [
    'bgx desktop',
    'download bgx',
    'background remover desktop app',
    'offline background removal',
    'ai background remover',
  ],
  ogImage: '/og-image.png',
  ogImageAlt: 'BGX Desktop App Download',
  siteName: 'BGX',
  locale: 'en_US',
};

let initialRelease: ReleaseInfo | null = null;
try {
  initialRelease = await fetchLatestRelease(6000);
} catch {
  // Build/dev environment may be offline — client falls back to cache or error state.
}
---

<Layout
  title={metadata.title}
  description={metadata.description}
  keywords={metadata.keywords.join(', ')}
  ogImage={metadata.ogImage}
  ogImageAlt={metadata.ogImageAlt}
  siteName={metadata.siteName}
  locale={metadata.locale}
  preconnect={['https://api.github.com']}
>
  <DownloadPage client:load initialRelease={initialRelease} />
</Layout>
